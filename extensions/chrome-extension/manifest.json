{
  "manifest_version": 3,
  "name": "SmartThings (Samsung) OAuth Helper",
  "version": "0.2.0",
  "description": "Captures the Samsung account sasdk:// redirect for the Home Assistant SmartThings integration.",
  "permissions": ["webNavigation", "tabs", "storage", "cookies"],
  "host_permissions": [
    "https://account.samsung.com/*",
    "https://ha-sasdk.example.com/*",
    "https://ha-oauth-assist.example.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SmartThings OAuth Helper"
  }
}
